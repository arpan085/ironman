# J.A.R.V.I.S. Iron Man AI Configuration
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred model (gemini-3.8-flash recommended for latest features & speed)
JARVIS_MODEL=gemini-3.8-flash

# Enable voice synthesis ("true" or "false")
JARVIS_VOICE=true
